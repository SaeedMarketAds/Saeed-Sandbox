# ===================================================================
# الشريط الجانبي (Sidebar)
# ===================================================================
with st.sidebar:
    st.image("https://via.placeholder.com/150/0e1117/6366f1?text=Saeed", width=150)
    st.markdown("## 🧠 الذاكرة والتعلم")
    st.write(f"**عدد المحادثات:** {len(memory['history'])}")
    st.write(f"**عدد التصحيحات:** {len(corrections)}")
    st.markdown("---")
    st.subheader("📦 قاعدة المعرفة")
    st.json(knowledge)
    st.markdown("---")
    if st.button("🗑️ مسح المحادثة"):
        st.session_state.messages = []
        st.rerun()

# ===================================================================
# منطقة المحادثة
# ===================================================================
st.title("🤖 Saeed LogiC Pro")
st.caption("مساعد التسوق الذكي – محادثة حرة بلا حدود")

if "messages" not in st.session_state:
    st.session_state.messages = [
        {"role": "assistant", "content": "مرحباً بك في Saeed LogiC Pro! 🛍️ اسألني عن أي منتج أو عرض، وسأبحث لك عن أفضل صفقة."}
    ]

for msg in st.session_state.messages:
    with st.chat_message(msg["role"]):
        st.markdown(msg["content"])
        if "audio" in msg and msg["audio"] and os.path.exists(msg["audio"]):
            st.audio(msg["audio"], format="audio/mp3")

# ===================================================================
# مدخل المستخدم
# ===================================================================
if prompt := st.chat_input("اكتب ما شئت... اسأل أو اطلب عرضك"):
    st.session_state.messages.append({"role": "user", "content": prompt})
    with st.chat_message("user"):
        st.markdown(prompt)

    with st.chat_message("assistant"):
        reply = get_ai_reply(prompt)
        st.markdown(reply)

        audio_file = generate_audio(reply)
        if audio_file and os.path.exists(audio_file):
            st.audio(audio_file, format="audio/mp3")

        st.session_state.messages.append({
            "role": "assistant",
            "content": reply,
            "audio": audio_file if audio_file else None
        })

        save_conversation(prompt, reply)

